<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: yt-dlp, Supabase y miniaturas. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Almacenamiento: desde Android 10 (API 29) guardamos en Descargas/Movies/Music vía
         MediaStore SIN permisos. Solo Android 8-9 (API 26-28) necesita este permiso. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Biblioteca: mostrar también la música que el usuario ya tiene en el teléfono (MP3 de
         otras apps). Solo audio; los videos se leen de la carpeta de la app, sin permisos.
         Android 13+ usa READ_MEDIA_AUDIO; las versiones anteriores, el permiso de almacenamiento. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notificación de progreso (Android 13+ la pide en tiempo de ejecución). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Descarga en primer plano (Fase 4: WorkManager usa un Foreground Service de tipo dataSync). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Reproductor: sigue sonando en segundo plano (Foreground Service de tipo mediaPlayback). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".ExoTubeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExoTube">

        <!-- Pantalla principal (icono del launcher). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ExoTube"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Destino de "Compartir": Activity transparente que solo muestra el Bottom Sheet
             encima de TikTok/YouTube/etc. No aparece en "Recientes". -->
        <activity
            android:name=".share.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.ExoTube.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WorkManager ejecuta los workers "de primer plano" en este servicio suyo. Desde Android 14
             hay que declarar su tipo; tools:node="merge" solo añade el atributo a la declaración
             que ya trae la librería. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Servicio del reproductor. exported="true" es obligatorio: así lo encuentran la
             notificación multimedia, la pantalla de bloqueo y los dispositivos Bluetooth. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
