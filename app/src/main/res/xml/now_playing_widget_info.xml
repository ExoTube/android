<?xml version="1.0" encoding="utf-8"?>
<!--
    La ficha del widget para el selector de widgets del teléfono.

    updatePeriodMillis="0": el widget no se actualiza cada X tiempo por su cuenta. Lo actualiza el
    servicio de reproducción cuando algo cambia, que es lo único que tiene sentido para un
    reproductor (y lo que no gasta batería de más).

    minWidth/minHeight de 180 dp: es lo que hace que casi cualquier lanzador lo ponga en 3x3
    casillas. Con más, muchos lo subían a 4x4 y el widget se comía media pantalla. Dentro de ese
    hueco se usa la versión normal si cabe, o la compacta si no (ver WidgetLayouts).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_now_playing"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:previewImage="@drawable/widget_vinyl"
    android:previewLayout="@layout/widget_now_playing"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
